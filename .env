# Horizon Environment Variables
# Copy this file to .env.local and customize for your environment

# =============================================================================
# REQUIRED: Google API Key for Gemini model (used by cagent)
# Get one from: https://aistudio.google.com/apikey
# =============================================================================
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# HTTP server host (default: 127.0.0.1)
HORIZON_SERVER_HOST=127.0.0.1

# HTTP server port (default: 8080)
HORIZON_SERVER_PORT=8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite database path (default: ./data/horizon.db)
# Directory will be created if it doesn't exist
HORIZON_DB_PATH=./data/horizon.db

# =============================================================================
# PODMAN CONFIGURATION
# =============================================================================
# Podman socket path (default: auto-detect from XDG_RUNTIME_DIR)
# Leave empty for auto-detection: /run/user/$UID/podman/podman.sock
HORIZON_PODMAN_SOCKET=

# Container image name (default: localhost/horizon-sandbox:latest)
# Must be built with: podman build -t localhost/horizon-sandbox:latest ./runtime
HORIZON_PODMAN_IMAGE=localhost/horizon-sandbox:latest

# Podman API version (default: v4.0.0)
HORIZON_PODMAN_API_VERSION=v4.0.0

# Request timeout for Podman API calls (default: 30s)
HORIZON_PODMAN_REQUEST_TIMEOUT=30s

# Container execution timeout (default: 10m)
# Maximum time a container can run before being force-stopped
HORIZON_PODMAN_CONTAINER_TIMEOUT=10m

# =============================================================================
# AGENT DEFAULTS
# =============================================================================
# Default timeout for agent execution (default: 10m)
HORIZON_AGENT_DEFAULT_TIMEOUT=10m

# Default container image for agents (default: localhost/horizon-sandbox:latest)
HORIZON_AGENT_DEFAULT_IMAGE=localhost/horizon-sandbox:latest

# =============================================================================
# LOGGING (Future: structured logging with slog)
# =============================================================================
# Log level: debug, info, warn, error (default: info)
HORIZON_LOG_LEVEL=info

# Log format: text, json (default: text)
HORIZON_LOG_FORMAT=text

# =============================================================================
# DEVELOPMENT / DEBUGGING
# =============================================================================
# Enable debug mode (default: false)
HORIZON_DEBUG=false

# Skip health check on startup (default: false)
HORIZON_SKIP_HEALTH_CHECK=false